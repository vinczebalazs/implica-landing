{
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/og/:scope/:file",
      "destination": "https://api.implica.app/og/:scope/:file"
    },
    {
      "source": "/story/:scope/:eventId",
      "destination": "/api/story?scope=:scope&eventId=:eventId"
    },
    {
      "source": "/redeem-code",
      "destination": "/api/redeem"
    },
    {
      "source": "/stories",
      "destination": "/api/stories"
    },
    {
      "source": "/world/:slug",
      "destination": "/api/article?scope=world&slug=:slug"
    },
    {
      "source": "/hu/hirek",
      "destination": "/api/stories?lang=hu"
    },
    {
      "source": "/hu/vilag/:slug",
      "destination": "/api/article?scope=world&lang=hu&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/sitemap?type=news"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
